<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinza_fundo"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cadastro rápido de contato -->
    <EditText
        android:id="@+id/edtNomeContato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nome_contato" />

    <EditText
        android:id="@+id/edtNumeroContato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/hint_numero_contato"
        android:inputType="phone" />

    <Button
        android:id="@+id/btnSalvarContato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/azul_primario"
        android:text="@string/btn_salvar_contato"
        android:textColor="@color/white" />

    <!-- Barra de pesquisa -->
    <EditText
        android:id="@+id/edtPesquisar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/hint_pesquisar" />

    <ListView
        android:id="@+id/listViewContatos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp" />

</LinearLayout>
